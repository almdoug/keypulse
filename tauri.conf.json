{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyPulse",
  "version": "1.0.0",
  "identifier": "com.keypulse.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KeyPulse",
        "width": 1280,
        "height": 800,
        "minWidth": 1060,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "backgroundColor": "#08090d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
